---
/**
 * L'accueil.
 *
 * L'ordre des sections est pensé pour un programmateur : le widget, puis ce
 * qu'il peut réserver, puis à quoi ça ressemble, puis les dates, et l'histoire
 * seulement ensuite.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Formations from '../components/sections/Formations.astro';
import Ecouter from '../components/sections/Ecouter.astro';
import Repertoire from '../components/sections/Repertoire.astro';
import Concerts from '../components/sections/Concerts.astro';
import Histoire from '../components/sections/Histoire.astro';
import Contact from '../components/sections/Contact.astro';
import DonneesStructurees from '../components/DonneesStructurees.astro';

import { ogImage } from '../lib/og';

const description =
  'Six chanteurs a cappella à Grenoble, une voix par partie. KatréKatr Set chante à six voix mixtes, et à quatre voix graves sous le nom de Katr Tet.';
// La photo de juillet 2026 montre le groupe à sept, Aurore comprise. En
// attendant une photo à six (ou une image de partage dessinée par Mathilde),
// on partage l'ambiance du concert, comme les pages de formation sans photo.
const partage = await ogImage('public-chenoise');
---

<Base title="Ensemble vocal à Grenoble" description={description} image={partage}>
  <DonneesStructurees
    slot="head"
    nom="KatréKatr Set"
    description={description}
    effectif={6}
    url={new URL(Astro.url.pathname, Astro.site)}
  />

  <Hero titre="KatréKatr Set, ensemble vocal a cappella à Grenoble" />
  <Formations />
  <Ecouter />
  <Repertoire />
  <Concerts />
  <Histoire />
  <Contact />
</Base>
