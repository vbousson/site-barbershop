---
/**
 * Trois cartes au gabarit strictement identique : même format, même longueur
 * de texte, même nombre de puces. L'égalité entre les trois formations ne se
 * décrète pas, elle s'impose par la contrainte typographique.
 */
import SectionHead from '../SectionHead.astro';
import Photo from '../Photo.astro';
import { getFormations } from '../../lib/content';
import { href } from '../../lib/url';

const formations = await getFormations();
---

<section id="formations">
  <div class="wrap">
    <SectionHead
      eyebrow="Trois formations"
      titre="Une voix par tête"
      lede="Personne ne double personne : chaque partie est tenue par un seul chanteur. Ça change l'équilibre, l'écoute, et le risque. Trois configurations sont disponibles à la programmation."
      tie={0}
      rot={-4}
    />

    <div class="cards">
      {
        formations.map((f) => (
          <article class="card rv">
            <Photo photo={f.data.photo} attendue={f.data.photoAttendue} />
            <div class="n">
              {f.data.effectif}
              <small>
                {f.data.registre} · {f.data.notation}
              </small>
            </div>
            <h3>
              <a href={href(`formations/${f.id}`)}>{f.data.nom}</a>
            </h3>
            <p>{f.data.resume}</p>
            <ul>
              {f.data.puces.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Les cartes de formation. */
  /* ═══ cartes de formation ═══
     Gabarit strictement identique pour les trois. */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.1rem, 2.4vw, 2.2rem);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .card .n {
    font-family: var(--font-numeral);
    font-weight: 800;
    font-size: 3.4rem;
    line-height: 0.8;
    margin-top: 0.4rem;
  }

  .card .n small {
    display: block;
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-top: 0.5rem;
    font-family: var(--font-body);
  }

  .card h3 a {
    text-decoration: none;
    border-bottom: 2px solid var(--gold);
  }

  .card h3 a:hover {
    border-bottom-color: var(--ink);
  }

  .card p {
    font-size: 0.94rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .card ul {
    list-style: none;
    margin: 0;
    padding: 0.7rem 0 0;
    border-top: var(--rule);
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .card ul li {
    padding: 0.14rem 0;
  }
</style>
