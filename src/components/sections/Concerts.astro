---
/**
 * L'agenda. Placé AVANT l'histoire : ce qu'on peut réserver prime sur d'où
 * l'on vient.
 *
 * Le partage à venir / déjà joué se calcule au build à partir des dates ISO.
 * Une date passée bascule donc toute seule au prochain déploiement.
 */
import SectionHead from '../SectionHead.astro';
import Chip from '../Chip.astro';
import Photo from '../Photo.astro';
import { getConcerts, getFormationIndex, dateLongue } from '../../lib/content';
import type { FormationId } from '../../data/formations';

interface Props {
  formation?: FormationId;
  alt?: boolean;
}

const { formation, alt = true } = Astro.props;

const index = await getFormationIndex();
const { avenir, passe } = await getConcerts();
const garde = (c: { data: { formation: FormationId } }) => !formation || c.data.formation === formation;
const aVenir = avenir.filter(garde);
const dejaJoue = passe.filter(garde);
---

<section id="concerts" class={alt ? 'alt' : undefined}>
  <div class="wrap">
    <SectionHead
      eyebrow="Agenda"
      titre="Concerts"
      lede="Où nous entendre prochainement, et ce qu'on a déjà joué. Cours d'immeuble, salles, scène ouverte, hôpital, mariage : on sort régulièrement, dans des formats très différents."
      tie={3}
      rot={5}
    />

    {/* Ce qu'un programmateur veut voir avant les dates : qu'il y a du monde.
        Réservé à l'agenda complet : sur une page de formation, la photo d'un
        concert donné surplomberait une liste filtrée à laquelle elle
        n'appartient pas forcément. */}
    {
      !formation && (
        <div class="bandeau rv">
          <Photo
            photo="public-chenoise"
            attendue=""
            ratio="21 / 8"
            widths={[640, 1024, 1440]}
            sizes="(max-width: 1200px) 92vw, 1160px"
            legende
          />
        </div>
      )
    }

    <p class="subh">À venir</p>
    {
      aVenir.length === 0 ? (
        <p class="empty rv">Prochaine date en cours de calage.</p>
      ) : (
        <ul class="dts rv">
          {aVenir.map((c) => (
            <li>
              <time datetime={c.data.date!}>{dateLongue(c.data.date!)}</time>
              <span>{c.data.lieu}{c.data.description && ` · ${c.data.description}`}</span>
              <Chip formation={c.data.formation} index={index} statique={!!formation} />
              <span />
            </li>
          ))}
        </ul>
      )
    }

    <p class="subh">Déjà joué</p>
    {
      dejaJoue.length === 0 ? (
        <p class="empty rv">Rien encore à cette affiche.</p>
      ) : (
        <ul class="dts past rv">
          {dejaJoue.map((c) => (
            <li>
              {c.data.date ? (
                <time datetime={c.data.date}>{dateLongue(c.data.date)}</time>
              ) : (
                <span class="nodate brouillon">
                  Date à retrouver<span class="sr"> (à compléter)</span>
                </span>
              )}
              <span class:list={{ brouillon: c.data.brouillon }}>
                {c.data.lieu}{c.data.description && ` · ${c.data.description}`}
              </span>
              <Chip formation={c.data.formation} index={index} statique={!!formation} />
              {/* Fragment nu : la section « Écouter » existe sur l'accueil
                  comme sur chaque page de formation. */}
              {c.data.enregistrement ? (
                <a class="rec" href="#ecouter">
                  Écouter
                </a>
              ) : (
                <span />
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  /* Les lignes de date et le bandeau photo. */
  /* ═══ concerts ═══ */
  .subh {
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 42%, transparent);
    margin: 2.4rem 0 0.7rem;
  }

  .subh:first-of-type {
    margin-top: 0;
  }

  .bandeau {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .dts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dts li {
    display: grid;
    grid-template-columns: 7.6rem minmax(0, 1fr) auto auto;
    gap: 0.6rem 1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: var(--rule);
  }

  .dts li:first-child {
    border-top: var(--rule);
  }

  .dts time,
  .dts .nodate {
    font-weight: 700;
    font-size: 0.82rem;
  }

  .dts.past {
    color: color-mix(in srgb, var(--ink) 62%, transparent);
  }

  .dts .rec {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gold-deep);
    white-space: nowrap;
    border-bottom: 1.5px solid currentColor;
  }

  .dts .rec:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .dts li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .dts time,
    .dts .nodate {
      grid-column: 1 / -1;
    }
  }
</style>
