---
/**
 * Les captations de salle.
 *
 * Tant qu'une piste n'a pas d'`url`, son bouton est désactivé plutôt que
 * trompeur : rien de pire qu'un triangle de lecture qui ne joue rien.
 */
import SectionHead from '../SectionHead.astro';
import Chip from '../Chip.astro';
import { getEnregistrements, getFormationIndex } from '../../lib/content';
import type { FormationId } from '../../data/formations';

interface Props {
  /** Sur une page de formation, on ne montre que ses propres captations. */
  formation?: FormationId;
  alt?: boolean;
}

const { formation, alt = true } = Astro.props;

const index = await getFormationIndex();
const tous = await getEnregistrements();
const pistes = formation ? tous.filter((e) => e.data.formation === formation) : tous;

// Tant qu'aucune captation n'est en ligne, on le dit plutôt que de laisser
// quatre lignes grises parler à notre place.
const rienEnLigne = pistes.length > 0 && pistes.every((p) => p.data.url === null);
---

<section id="ecouter" class={alt ? 'alt' : undefined}>
  <div class="wrap">
    <SectionHead
      eyebrow="Enregistrements"
      titre="Écouter"
      lede="Captations de salle, telles quelles, sans retouche. C'est ce que vous entendrez le soir du concert."
      tie={1}
      rot={3}
    />

    {
      pistes.length === 0 ? (
        <p class="empty rv">Pas encore de captation pour cette formation.</p>
      ) : (
        <div class="tracks">
          {
            rienEnLigne && (
              <p class="empty rv">
                Les captations sont en cours de montage. Écrivez-nous en attendant, on vous envoie
                un extrait.
              </p>
            )
          }
          {pistes.map((p) => (
            <button class="trk rv" type="button" disabled={p.data.url === null}>
              <span class="pl">
                <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                  <path d="M0 0l10 6-10 6z" />
                </svg>
              </span>
              <span>
                <strong class:list={{ brouillon: p.data.brouillon }}>
                  {p.data.titre}
                  {p.data.brouillon && <span class="sr"> (à compléter)</span>}
                </strong>
                <span class="meta">
                  {p.data.lieu} · {p.data.quand}
                </span>
              </span>
              {/* Toujours statique : un lien dans un bouton n'est pas du HTML valide. */}
              <Chip formation={p.data.formation} index={index} statique />
              <span class="d">{p.data.duree}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Les lignes de piste. */
  /* ═══ pistes à écouter ═══ */
  .trk {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.6rem 1rem;
    align-items: center;
    padding: 0.95rem 0;
    border-bottom: var(--rule);
    width: 100%;
    text-align: left;
  }

  .trk:first-child {
    border-top: var(--rule);
  }

  .trk .pl {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    transition: background 0.2s;
  }

  .trk:not([disabled]):hover .pl {
    background: var(--gold);
  }

  .trk[disabled] {
    cursor: default;
  }

  .trk .pl svg {
    width: 9px;
    translate: 1px 0;
  }

  .trk strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
  }

  .trk span.meta {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ink) 52%, transparent);
  }

  .trk .d {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ink) 52%, transparent);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .trk {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    /* L'étiquette est rendue par le composant Chip : elle porte SA portée,
       pas celle d'ici. Sans le :global(), la puce reste en 3e colonne et la
       ligne se réorganise de travers sur mobile. */
    .trk :global(.chip) {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
