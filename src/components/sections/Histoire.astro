---
/**
 * La frise, six jalons.
 *
 * Chaque jalon porte un nœud papillon de Mathilde, tous à la même taille, en
 * alternant les quatre variantes pour que deux voisins ne soient jamais
 * identiques. Le drapeau `cle` du contenu n'est plus utilisé à l'affichage.
 */
import SectionHead from '../SectionHead.astro';
import Bowtie from '../Bowtie.astro';
import { getFrise } from '../../lib/content';

interface Props {
  alt?: boolean;
}

const { alt = false } = Astro.props;
const jalons = await getFrise();

/**
 * Trois chapôs à l'essai, volontairement opposés. Changer la lettre ci-dessous
 * suffit à basculer. À réduire à un seul une fois tranché.
 *
 *   a  humain et modeste, on se moque un peu de nous
 *   b  factuel et sec, le chapô annonce une chronologie
 *   c  le son d'abord, la raison musicale du groupe
 */
const CHAPO = 'c' as 'a' | 'b' | 'c';

const CHAPOS = {
  a: "Sept chanteurs, deux quatuors, un ténor qui n'a jamais voulu choisir. Voilà comment on en est arrivés là.",
  b: "Un quatuor monté en 2018, arrêté par le covid, reformé, puis doublé d'un second en 2024. Les jalons, dans l'ordre.",
  c: "Au départ, on voulait juste entendre un accord vraiment juste à quatre voix. Les concerts, le second quatuor, les logos, tout ça est venu après.",
};
---

<section id="histoire" class={alt ? 'alt' : undefined}>
  <div class="wrap">
    <SectionHead
      eyebrow="Le projet"
      titre="L'histoire"
      lede={CHAPOS[CHAPO]}
      tie={0}
      rot={7}
    />

    <ol class="tl2 rv">
      {
        jalons.map((j, i) => (
          <li class:list={{ cle: j.data.cle }}>
            <span class="yr">{j.data.annee}</span>
            <span class="rail">
              <Bowtie n={i} rot={(i % 2 ? 5 : -5) + (i % 3)} tiny />
            </span>
            <div>
              <h3>{j.data.titre}</h3>
              <p>{j.data.texte}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* La frise verticale. */
  /* ═══ frise historique ═══ */
  .tl2 {
    --c1: clamp(3rem, 7vw, 4.4rem);
    --c2: 2rem;
    --gp: clamp(0.6rem, 2vw, 1.2rem);
    position: relative;
    list-style: none;
    /* Le bloc est centré dans la page : sans ça la frise se colle à la marge
       gauche et laisse un grand vide à droite. */
    max-width: 44rem;
    margin-inline: auto;
    padding: 0;
  }

  .tl2::before {
    content: '';
    position: absolute;
    top: 0.7rem;
    bottom: 2.6rem;
    left: calc(var(--c1) + var(--gp) + var(--c2) / 2 - 1px);
    width: 2px;
    background: linear-gradient(color-mix(in srgb, var(--ink) 20%, transparent) 88%, transparent);
  }

  .tl2 li {
    display: grid;
    grid-template-columns: var(--c1) var(--c2) minmax(0, 1fr);
    gap: 0 var(--gp);
    padding-bottom: clamp(1.5rem, 3.2vw, 2.4rem);
  }

  .tl2 .yr {
    font-family: var(--font-numeral);
    font-weight: 800;
    line-height: 0.85;
    text-align: right;
    font-size: clamp(1.45rem, 3.4vw, 2.15rem);
    color: var(--gold-deep);
    letter-spacing: -0.01em;
  }

  .tl2 .rail {
    position: relative;
  }

  /* Le nœud est rendu par Bowtie et porte donc SA portée, pas celle d'ici :
     la partie enfant du sélecteur doit être globale. */
  .tl2 .rail> :global(*) {
    position: absolute;
    left: 50%;
    top: 0.25rem;
    translate: -50% 0;
  }

  .tl2 h3 {
    margin: 0 0 0.2rem;
    font-size: 0.92rem;
  }

  .tl2 p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  /* Chaque jalon porte un nœud papillon. Le halo de la couleur du fond coupe le
     filet vertical derrière lui, sinon la ligne traverse le nœud de part en part. */
  .tl2 .rail> :global(.tie) {
    top: 0.1rem;
    width: 30px;
    padding: 0 2px;
    background: var(--paper);
  }

  .alt .tl2 .rail> :global(.tie) {
    background: var(--wash);
  }
</style>
