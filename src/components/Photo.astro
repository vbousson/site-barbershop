---
/**
 * Une photo de concert, ou le cadre vide qui en tient la place.
 *
 * Le format est le même dans les trois cartes de formation, photo ou pas :
 * l'égalité entre les formations ne se décrète pas, elle s'impose par le
 * gabarit — et une formation sans photo ne doit pas paraître plus petite.
 */
import { Image } from 'astro:assets';
import { PHOTOS, type PhotoId } from '../data/photos';

interface Props {
  photo: PhotoId | null;
  /** Texte du cadre vide, quand il n'y a pas encore de photo. */
  attendue: string;
  /** Largeurs générées. Par défaut, celles d'une carte de formation. */
  widths?: number[];
  sizes?: string;
  /** Format du cadre. Les groupes sont larges, jamais carrés. */
  ratio?: string;
  /** Affiche la légende sous la photo. */
  legende?: boolean;
  /** Charge la photo sans attendre : à réserver au premier écran. */
  prioritaire?: boolean;
}

const {
  photo,
  attendue,
  widths = [420, 640, 900],
  sizes = '(max-width: 900px) 92vw, 33vw',
  ratio = '4 / 3',
  legende = false,
  prioritaire = false,
} = Astro.props;

const p = photo ? PHOTOS[photo] : null;
---

{
  p ? (
    <figure class="photo" style={`--ratio:${ratio}`}>
      <Image
        src={p.src}
        alt={p.alt}
        widths={widths}
        sizes={sizes}
        loading={prioritaire ? 'eager' : 'lazy'}
        style={`object-position:${p.cadrage}`}
      />
      {legende && <figcaption>{p.credit}</figcaption>}
    </figure>
  ) : (
    <div class="photo vide" style={`--ratio:${ratio}`}>
      <span>{attendue}</span>
    </div>
  )
}

<style>
  .photo {
    margin: 0;
    aspect-ratio: var(--ratio);
    border-radius: 0.7rem;
    overflow: hidden;
    border: 2px solid var(--ink);
    position: relative;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo figcaption {
    position: absolute;
    inset: auto 0 0;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    color: var(--wash);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 0.45rem 0.8rem;
  }
  /* Le cadre vide reprend exactement l'encombrement de la photo. */
  .vide {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1.5rem;
    background: var(--wash);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 40%, transparent);
  }
  :global(.alt) .vide {
    background: var(--paper);
  }
</style>
