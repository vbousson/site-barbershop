---
/**
 * Un nœud papillon aquarellé de Mathilde, en marqueur.
 * Quatre variantes, choisies par index pour qu'aucun voisin n'ait le même.
 * Décoratif : jamais annoncé aux lecteurs d'écran.
 */
import { Image } from 'astro:assets';
import tie1 from '../assets/bowties/1.png';
import tie2 from '../assets/bowties/2.png';
import tie3 from '../assets/bowties/3.png';
import tie4 from '../assets/bowties/4.png';

const TIES = [tie1, tie2, tie3, tie4];

interface Props {
  /** Index de la variante, ramené dans 0–3. */
  n?: number;
  /** Inclinaison, en degrés. */
  rot?: number;
  /** Gabarit d'emploi : chapeau de section, jalon de frise, puce de liste. */
  size?: 'section' | 'frise' | 'puce';
}

const { n = 0, rot = 0, size = 'section' } = Astro.props;
const src = TIES[((n % TIES.length) + TIES.length) % TIES.length]!;
---

<Image
  class:list={['tie', size]}
  src={src}
  alt=""
  aria-hidden="true"
  style={`--rot:${rot}deg`}
/>

<style>
  /* Le nœud papillon. Sa position dans la frise est réglée par Histoire. */
  /* Les nœuds papillon de Mathilde servent de marqueur en tête de section. */
  .tie {
    display: block;
    height: auto;
    rotate: var(--rot, 0deg);
  }

  .tie.section {
    width: clamp(40px, 5.2vw, 60px);
    margin-bottom: 0.85rem;
  }

  .tie.frise {
    width: 30px;
    margin: 0;
  }

  /* En puce de liste, il tient la place d'une glyphe : la largeur suit le
     texte à côté plutôt qu'un réglage fixe. */
  .tie.puce {
    width: 2.1em;
    margin: 0;
  }
</style>
