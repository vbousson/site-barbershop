---
/**
 * Le hero : l'aquarelle de Mathilde (le fond de ses affiches, sans texte) et
 * le plateau au milieu. Le disque blanc est géré par le plateau, pas par
 * l'image, pour tomber au bon endroit quelle que soit la largeur.
 *
 * Le hero est commun aux quatre pages, simplement pré-réglé sur une formation
 * différente.
 */
import { Image } from 'astro:assets';
import Plateau from './Plateau.astro';
import aquarelle from '../assets/fond/aquarelle.jpg';
import type { FormationId } from '../data/formations';

interface Props {
  formation?: FormationId;
  /** Le h1 de la page. Visible pour les lecteurs d'écran et les moteurs,
   *  masqué à l'œil : c'est le logo qui tient le titre. */
  titre: string;
}

const { formation, titre } = Astro.props;
---

<div class="hero">
  <Image
    class="fond"
    src={aquarelle}
    alt=""
    widths={[800, 1400, 2000, 2800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="wrap hero-in">
    <h1 class="hero-title">{titre}</h1>
    <Plateau formation={formation} />
  </div>
</div>

<style>
  /* ═══ hero aquarelle ═══
     L'aquarelle couvre tout le hero ; les rayons dorés partent d'en bas à
     droite, on garde donc ce coin quand l'écran rogne l'image. */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 5.9rem 0 3rem;
    background: var(--wash);
  }

  .fond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 75%;
    pointer-events: none;
    /* En filigrane : l'aquarelle donne la matière, pas la couleur. */
    opacity: 0.32;
    filter: saturate(0.6);
  }

  .hero-in {
    position: relative;
    z-index: 3;
  }

  .hero-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
