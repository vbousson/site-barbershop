---
/**
 * La barre haute. Elle devient opaque dès qu'on quitte le hero, sinon elle
 * flotte sur le lavis. Les liens de navigation pointent tous vers les
 * sections de l'accueil : le site tient sur une page, plus trois pages de
 * formation pour les programmateurs.
 */
import { Image } from 'astro:assets';
import { anchor, href } from '../lib/url';
import { SITE } from '../data/site';
import { MARKS } from '../data/images';

const liens = [
  { id: 'formations', label: 'Formations' },
  { id: 'ecouter', label: 'Écouter' },
  { id: 'repertoire', label: 'Répertoire' },
  { id: 'concerts', label: 'Concerts' },
  { id: 'histoire', label: 'Histoire' },
];
---

<header class="top" id="top">
  {/* Le logotype de Mathilde plutôt que le nom composé en Big Shoulders. */}
  <a class="brand" href={href()} aria-label={`${SITE.titre}, retour à l'accueil`}>
    <Image src={MARKS.sept} alt={`${SITE.titre}, ensemble vocal`} widths={[110, 220]} sizes="110px" />
  </a>
  <nav aria-label="Navigation principale">
    <span class="links">
      {liens.map((l) => <a href={anchor(l.id)}>{l.label}</a>)}
    </span>
    <a class="cta" href={`mailto:${SITE.mail}`}>Nous écrire</a>
  </nav>
</header>

<script>
  import '../scripts/topbar';
</script>

<style>
  /* La barre haute. */
  /* ═══ barre haute ═══ */
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem var(--gut);
    font-size: 0.82rem;
    transition: background 0.3s, box-shadow 0.3s;
  }

  .top.solid {
    background: color-mix(in srgb, var(--wash) 94%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* Le logotype de Mathilde, en petit. Il descend sous sa ligne de base (la
     hampe du 7), d'où la hauteur un peu généreuse et le recentrage optique. */
  .top .brand {
    display: block;
    line-height: 0;
    text-decoration: none;
    flex: 0 0 auto;
  }

  /* En dessous de ~60 px, la mention « Ensemble vocal » du logotype se réduit à
     une tache : on descend donc moins que ça, et le hero dégage la place. */
  .top .brand img {
    height: clamp(2.9rem, 4.4vw, 4rem);
    width: auto;
    display: block;
  }

  .top nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .top .links {
    display: flex;
    gap: 1.2rem;
  }

  .top nav a {
    text-decoration: none;
    font-weight: 500;
    opacity: 0.7;
  }

  .top nav a:hover,
  .top nav a[aria-current='page'] {
    opacity: 1;
  }

  /* `.top nav a` gagnerait sur `.top .cta` une fois la portée appliquée :
     Astro ajoute un attribut par compound, ce qui inverse la spécificité.
     D'où le sélecteur plus précis. */
  .top nav a.cta {
    opacity: 1;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.32rem 0.85rem;
    font-weight: 700;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .top nav a.cta:hover {
    background: var(--gold);
  }

  @media (max-width: 900px) {
    .top .links {
      display: none;
    }
  }
</style>
