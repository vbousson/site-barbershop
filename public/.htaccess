# Hébergement OVH (Apache). Ignoré par Firebase, qui a son firebase.json.
#
# Une erreur de syntaxe ici donne une erreur 500 sur tout le site : après
# chaque modification, recharger la page d'accueil tout de suite.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Tout en HTTPS, sur le domaine nu (certificat Let's Encrypt en place depuis
# novembre 2026). Sans certificat, ces lignes rendraient le site inaccessible.
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://katrekatrset.fr/$1 [R=301,L]

# Raccourcis lisibles, à imprimer sur une affiche.
RewriteRule ^4plus4/?$ /formations/4plus4/ [R=301,L]
RewriteRule ^katr-?tet/?$ /formations/katr-tet/ [R=301,L]

<IfModule mod_headers.c>
  # HSTS : un navigateur ne le retient que s'il le reçoit en HTTPS, donc sans
  # effet tant que le certificat n'est pas là.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Les fichiers de _astro/ ont leur empreinte dans le nom : cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
